#!/bin/bash
# Remove an older Avel Tape of the same kind so the new one replaces it cleanly.
# $1 is the path of the component package being installed.
if [ "$(basename "$1")" = "AvelTape-VST3.pkg" ]; then
    rm -rf "/Library/Audio/Plug-Ins/VST3/Avel Tape.vst3"
elif [ "$(basename "$1")" = "AvelTape-AU.pkg" ]; then
    rm -rf "/Library/Audio/Plug-Ins/Components/Avel Tape.component"
fi
exit 0
